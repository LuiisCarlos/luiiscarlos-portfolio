---
import { Github, Linkedin, Mail, SquareArrowOutUpRight } from "lucide-react";

type Props = {
  name: string;
  email: string;
  github: string;
  linkedin: string;
  resume?: string;
};

const { name, email, github, linkedin, resume } = Astro.props;

const currentYear = new Date().getFullYear();

// `resume` puede venir vacío: en ese caso no se renderiza el enlace en vez de
// dejar un <a href="">.
const quickLinks = [
  { text: "About", href: "#about" },
  { text: "Experience", href: "#experience" },
  { text: "Projects", href: "#projects" },
  { text: "Education", href: "#formation" },
  ...(resume ? [{ text: "Resume", href: resume }] : []),
];

const socials = [
  { label: "GitHub", href: github, Icon: Github, external: true },
  { label: "LinkedIn", href: linkedin, Icon: Linkedin, external: true },
  // mailto: no debe abrir una pestaña nueva: deja una en blanco al lanzar el
  // cliente de correo.
  { label: "Email", href: `mailto:${email}`, Icon: Mail, external: false },
];
---

<footer class="bg-card border-border mt-20 w-full border-t">
  <div class="mx-auto max-w-6xl px-6 py-10 lg:px-16">
    <div class="grid grid-cols-1 gap-10 sm:grid-cols-2 lg:grid-cols-3">
      <div class="space-y-5">
        <h2 class="text-accent text-2xl font-bold">Get in touch</h2>
        <p class="text-muted text-sm">
          I'm always open to discussing new opportunities and interesting projects.
        </p>
        <a
          href={`mailto:${email}`}
          class="hover:text-accent flex flex-row items-center gap-2 text-sm transition-colors"
        >
          <Mail size={16} aria-hidden="true" />
          {email}
        </a>
      </div>

      <div>
        <h2 class="text-accent mb-5 text-2xl font-bold">Quick links</h2>
        <ul class="space-y-2">
          {
            quickLinks.map((link) => (
              <li>
                <a
                  class="text-muted hover:text-foreground group inline-flex items-center gap-1 text-sm transition-colors"
                  href={link.href}
                >
                  {link.text}
                  {link.text === "Resume" && (
                    <SquareArrowOutUpRight size={14} aria-hidden="true" className="inline-block" />
                  )}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div>
        <h2 class="text-accent mb-5 text-2xl font-bold">Connect</h2>
        <ul class="flex flex-row gap-5">
          {
            socials.map(({ label, href, Icon, external }) => (
              <li>
                <a
                  href={href}
                  class="border-accent/30 hover:border-accent/60 hover:bg-accent/10 grid size-12 place-items-center rounded-full border transition-all duration-300"
                  aria-label={label}
                  target={external ? "_blank" : undefined}
                  rel={external ? "noopener noreferrer" : undefined}
                >
                  <Icon size={20} aria-hidden="true" />
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <hr class="border-border my-10" />

    <div class="flex flex-col items-center justify-between gap-4 sm:flex-row">
      <code class="font-mono text-sm">
        <span class="text-accent">const</span>
        <span class="text-muted">developer = &lbrace;</span> name: '{name}'
        <span class="text-muted">&rbrace;</span>
      </code>
      <p class="text-muted text-sm">
        © {currentYear}
        {name}. Built with Astro, React &amp; GSAP.
      </p>
    </div>
  </div>
</footer>

---
import { ArrowLeft, ArrowRight, ExternalLink, Github } from "lucide-react";
import Layout from "@/layouts/Layout.astro";
import Footer from "@components/Footer.astro";
import ProjectGallery from "@components/ProjectGallery";
import { personal } from "@/data/personal";
import type { Lang } from "@/i18n/config";
import { getProjectContent } from "@/i18n/content";

// Cuerpo único del detalle para los dos idiomas, igual que Home.astro: las
// rutas /projects/[project] y /es/projects/[project] solo eligen el `lang`.
type Props = { lang: Lang; id: string };

const { lang, id } = Astro.props;
const project = getProjectContent(lang, id);
const { labels } = project;
---

<Layout lang={lang} title={`${project.title} — ${personal.name}`} description={project.description}>
  <article class="mx-auto max-w-4xl px-6 py-20 lg:px-16">
    <a
      href={project.backHref}
      class="text-muted hover:text-foreground group mb-10 inline-flex items-center gap-2 text-sm transition-colors"
    >
      <ArrowLeft
        size={16}
        aria-hidden="true"
        className="transition-transform group-hover:-translate-x-1"
      />
      {labels.back}
    </a>

    <header class="mb-10 space-y-4">
      <p class="text-accent font-mono text-sm font-medium">{project.typeLabel}</p>
      <h1 class="text-4xl font-bold sm:text-5xl lg:text-6xl">{project.title}</h1>
      <p class="text-muted text-lg leading-relaxed">{project.description}</p>
    </header>

    {
      (project.github || project.demo) && (
        <div class="mb-15 flex flex-col gap-3 sm:flex-row">
          {project.github && (
            <a
              href={project.github}
              target="_blank"
              rel="noopener noreferrer"
              class="bg-background border-border hover:bg-accent hover:border-accent hover:text-background flex items-center justify-center gap-2 rounded-sm border px-5 py-2.5 text-sm font-medium transition-all duration-200"
            >
              <Github size={16} aria-hidden="true" />
              {labels.viewCode}
            </a>
          )}

          {project.demo && (
            <a
              href={project.demo}
              target="_blank"
              rel="noopener noreferrer"
              class="bg-accent text-background hover:bg-accent/90 flex items-center justify-center gap-2 rounded-sm px-5 py-2.5 text-sm font-medium transition-all duration-200"
            >
              <ExternalLink size={16} aria-hidden="true" />
              {labels.liveDemo}
            </a>
          )}
        </div>
      )
    }

    {
      /* Sin imágenes en `gallery` (src/data/projects.ts) la sección no existe:
         mejor eso que un hueco vacío. */
      project.gallery.length > 0 && (
        <section class="mb-15">
          <h2 class="mb-6 text-2xl font-bold sm:text-3xl">{labels.gallery}</h2>
          <ProjectGallery
            client:visible
            images={project.gallery}
            aspect={project.galleryAspect}
            labels={project.galleryLabels}
          />
        </section>
      )
    }

    {
      /* El texto largo vive en `projects.<id>.detail` de src/i18n/ui.ts, un
         párrafo por entrada del array. Es opcional. */
      project.detail.length > 0 && (
        <section class="mb-15">
          <h2 class="mb-6 text-2xl font-bold sm:text-3xl">{labels.overview}</h2>
          <div class="space-y-5">
            {project.detail.map((paragraph) => (
              <p class="text-muted leading-relaxed">{paragraph}</p>
            ))}
          </div>
        </section>
      )
    }

    <section class="mb-15">
      <h2 class="mb-6 text-2xl font-bold sm:text-3xl">{labels.stack}</h2>
      <ul class="flex flex-wrap gap-2">
        {
          project.tech.map((tech) => (
            <li class="bg-card border-border rounded-sm border px-2.5 py-1 text-xs font-medium">
              {tech}
            </li>
          ))
        }
      </ul>
    </section>

    <nav
      aria-label={labels.siblings}
      class="border-border grid grid-cols-1 gap-4 border-t pt-10 sm:grid-cols-2"
    >
      <a
        href={project.previous.href}
        class="bg-card border-border hover:border-accent/30 group rounded-lg border p-5 transition duration-200"
      >
        <span class="text-muted flex items-center gap-2 text-xs">
          <ArrowLeft
            size={14}
            aria-hidden="true"
            className="transition-transform group-hover:-translate-x-1"
          />
          {labels.previousProject}
        </span>
        <span class="group-hover:text-accent mt-1 block font-semibold transition-colors">
          {project.previous.title}
        </span>
      </a>

      <a
        href={project.next.href}
        class="bg-card border-border hover:border-accent/30 group rounded-lg border p-5 text-right transition duration-200"
      >
        <span class="text-muted flex items-center justify-end gap-2 text-xs">
          {labels.nextProject}
          <ArrowRight
            size={14}
            aria-hidden="true"
            className="transition-transform group-hover:translate-x-1"
          />
        </span>
        <span class="group-hover:text-accent mt-1 block font-semibold transition-colors">
          {project.next.title}
        </span>
      </a>
    </nav>
  </article>

  <Footer lang={lang} />
</Layout>

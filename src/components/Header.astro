---
import LanguageSwitch from "@components/LanguageSwitch.astro";
import ThemeToggle from "@components/ThemeToggle.astro";
import type { Lang } from "@/i18n/config";
import { useTranslations } from "@/i18n/utils";

type Props = { lang: Lang };

const { lang } = Astro.props;
const t = useTranslations(lang);

const links = [
  { label: t("nav.about"), href: "#about" },
  { label: t("nav.experience"), href: "#experience" },
  { label: t("nav.projects"), href: "#projects" },
  { label: t("nav.education"), href: "#formation" },
];
---

<header
  id="site-header"
  class="border-border bg-background/80 sticky top-0 z-40 border-b backdrop-blur-md"
>
  <div class="mx-auto flex h-16 max-w-6xl items-center justify-between gap-3 px-6 lg:px-16">
    <a href="#content" class="font-mono text-sm font-bold whitespace-nowrap">
      luis<span class="text-accent">works</span>
    </a>

    <nav aria-label={t("a11y.sections")} class="hidden md:block">
      <ul class="flex items-center gap-6 text-sm">
        {
          links.map(({ label, href }) => (
            <li>
              <a href={href} class="text-muted hover:text-foreground transition-colors">
                {label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="flex items-center gap-2 sm:gap-3">
      <LanguageSwitch lang={lang} />
      <ThemeToggle label={t("a11y.theme")} />

      <button
        id="menu-toggle"
        type="button"
        class="border-border hover:bg-card grid size-9 shrink-0 cursor-pointer place-items-center rounded-md border transition-colors md:hidden"
        aria-label={t("a11y.menu")}
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <svg
          class="size-4"
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          aria-hidden="true"
        >
          <path class="menu-open" d="M3 6h18M3 12h18M3 18h18"></path>
          <path class="menu-close hidden" d="M6 6l12 12M18 6L6 18"></path>
        </svg>
      </button>
    </div>
  </div>

  <!-- Patrón disclosure: `hidden` de verdad, no solo invisible, para que el
       contenido plegado quede fuera del orden de tabulación. -->
  <nav
    id="mobile-menu"
    aria-label={t("a11y.sections")}
    class="border-border hidden border-t md:hidden"
  >
    <ul class="mx-auto max-w-6xl px-6 py-2">
      {
        links.map(({ label, href }) => (
          <li>
            <a
              href={href}
              class="text-muted hover:text-foreground block py-3 text-sm transition-colors"
            >
              {label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>

<script>
  const toggle = document.getElementById("menu-toggle");
  const menu = document.getElementById("mobile-menu");
  const header = document.getElementById("site-header");
  const iconOpen = document.querySelector<SVGPathElement>(".menu-open");
  const iconClose = document.querySelector<SVGPathElement>(".menu-close");

  const setOpen = (open: boolean) => {
    menu?.classList.toggle("hidden", !open);
    iconOpen?.classList.toggle("hidden", open);
    iconClose?.classList.toggle("hidden", !open);
    toggle?.setAttribute("aria-expanded", String(open));
  };

  toggle?.addEventListener("click", () => {
    setOpen(menu?.classList.contains("hidden") ?? false);
  });

  // Al navegar a una sección el menú debe cerrarse solo.
  menu?.querySelectorAll("a").forEach((link) => {
    link.addEventListener("click", () => setOpen(false));
  });

  document.addEventListener("keydown", (event) => {
    if (event.key !== "Escape" || menu?.classList.contains("hidden")) return;
    setOpen(false);
    toggle?.focus();
  });

  document.addEventListener("click", (event) => {
    if (menu?.classList.contains("hidden")) return;
    if (header?.contains(event.target as Node)) return;
    setOpen(false);
  });

  // Si se ensancha la ventana con el menú abierto, el nav de escritorio toma el
  // relevo y este panel debe volver a su estado cerrado.
  window.matchMedia("(min-width: 48rem)").addEventListener("change", (event) => {
    if (event.matches) setOpen(false);
  });
</script>

---
import Layout from "@/layouts/Layout.astro";
import HeroSection from "@components/HeroSection";
import AboutSection from "@components/AboutSection";
import ExperienceSection from "@components/ExperienceSection";
import ProjectsSection from "@components/ProjectsSection";
import FormationSection from "@components/FormationSection";
import Footer from "@components/Footer.astro";

// TODO(fase 2): mover a src/data/*.ts para poder alimentar / y /es/ con lo mismo.
const personalData = {
  name: "Luis Carlos",
  fullname: "Luis Carlos Caicedo Giraldo",
  role: "Backend Developer",
  email: "luisccg2003@gmail.com",
  experience: "1+ years",
  language: ["English", "Spanish"],
};

const personalLinks = {
  github: "https://github.com/luiiscarlos",
  linkedin: "https://linkedin.com/in/luiiscarlos",
  // TODO(pendiente): subir el CV a public/ y apuntar aquí. Vacío = no se renderiza.
  resume: "",
};
---

<Layout>
  {/* client:load solo para lo visible en el primer viewport. */}
  <HeroSection client:load name={personalData.name} />

  {/* El resto está bajo el fold: client:visible. */}
  <AboutSection
    client:visible
    fullname={personalData.fullname}
    email={personalData.email}
    experience={personalData.experience}
    language={personalData.language}
  />

  <ExperienceSection client:visible />

  <ProjectsSection client:visible />

  {/* Sin directiva: es puramente presentacional, no envía JS. */}
  <FormationSection />

  <Footer
    name={personalData.name}
    email={personalData.email}
    github={personalLinks.github}
    linkedin={personalLinks.linkedin}
    resume={personalLinks.resume}
  />
</Layout>
